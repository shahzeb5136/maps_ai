# Copy to `.env` for local development. On Railway these go in
# Service → Variables instead — never commit the filled-in file.

# ── Google ───────────────────────────────────────────────────────────────────
# Needs Geocoding API, Maps Static API and Street View Static API enabled
# on the key's Google Cloud project.
MAPS_API_KEY=AIza...
GEMINI_API_KEY=AIza...

# ── Database ─────────────────────────────────────────────────────────────────
# The SAME Postgres the website uses — the credits wallet is shared.
# On Railway, reference the plugin instead of pasting a URL: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/railway

# ── Clerk ────────────────────────────────────────────────────────────────────
# Clerk → Configure → API keys → "Frontend API URL". This is the `iss` claim of
# the session tokens the website sends.
#
# COMMA-SEPARATED, and you almost certainly need BOTH: the deployed site runs on
# your production Clerk instance while local development runs on a development
# one, and they sign tokens with different keys. Listing only one means the
# other gets "Invalid session token" on every request.
#
# To find an instance's issuer from a publishable key, base64-decode the part
# after pk_live_ / pk_test_ and strip the trailing "$".
CLERK_ISSUER=https://clerk.your-domain.com,https://your-instance-00.clerk.accounts.dev
# Optional, and only honoured when exactly one issuer is configured.
# CLERK_JWKS_URL=https://clerk.your-domain.com/.well-known/jwks.json

# ── Storage ──────────────────────────────────────────────────────────────────
# Must match the Railway volume mount path. Scans must outlive a redeploy.
STORAGE_DIR=/data

# ── Signed asset URLs ────────────────────────────────────────────────────────
# Any long random string: `openssl rand -hex 32`.
# Changing it invalidates every outstanding image and PDF link.
SIGNING_SECRET=change-me-to-a-long-random-string
SIGNED_URL_TTL_SECONDS=86400

# Absolute URL of this service. Railway fills this in from RAILWAY_PUBLIC_DOMAIN,
# so you only need it locally.
PUBLIC_BASE_URL=http://localhost:8002

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of the website's origins. No trailing slashes.
ALLOWED_ORIGINS=http://localhost:3000,https://your-website.com

# ── Tuning ───────────────────────────────────────────────────────────────────
SCAN_CREDIT_COST=1
MAX_CONCURRENT_SCANS=2
SCANNER_TIMEOUT_SECONDS=900
SCANNER_ENABLE_TEMPORAL=true
SCANNER_ENABLE_RENOVATION=true
SCANNER_MAX_PANOS=4
SCANNER_TEXT_MODEL=gemini-3.7-flash
SCANNER_IMAGE_MODEL=gemini-3.1-flash-image
LOG_LEVEL=INFO
